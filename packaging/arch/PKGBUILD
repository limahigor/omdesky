pkgname=omdesky
pkgver=0.1.1
pkgrel=1
pkgdesc='Omarchy-native remote desktop orchestration over Tailscale'
arch=('x86_64')
url='https://github.com/limahigor/omdesky'
license=('MIT')
depends=('tailscale' 'sunshine' 'moonlight-qt')
makedepends=('cargo')
source=()
sha256sums=()

build() {
  cargo build --release --locked --workspace
}

package() {
  install -Dm755 target/release/omdesky "$pkgdir/usr/bin/omdesky"
  install -Dm755 target/release/omdesky-agent "$pkgdir/usr/bin/omdesky-agent"
  install -Dm644 packaging/systemd/omdesky-agent.service "$pkgdir/usr/lib/systemd/user/omdesky-agent.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
